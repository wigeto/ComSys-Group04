# Replace 192.0.2.10:80 with each application's actual VM IP and port.

onlyoffice.pilot.internal {
	tls {
		issuer acme {
			dir https://step-ca:9000/acme/acme/directory
			trusted_roots /etc/caddy/root_ca.crt
		}
	}
	reverse_proxy 192.168.100.5:8081
}

